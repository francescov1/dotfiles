#!/usr/bin/env bash
# cswap auto-switch for Linux (systemd: cswap-auto.service), plus a wake-up for the OR fleet tmux session.
# Rotates subscription accounts at 80% of the 5h window / 85% of the weekly window. The API-key (credits) account is
# used only once cswap reports every subscription account exhausted, and left again as soon as one has headroom:
# cswap's own --include-api-key-accounts moves onto the key at the switch line and fails back off it after 3 ticks.
# A Claude Code session that hit the usage limit sits on its "Stop and wait for limit to reset" menu even after a
# switch, so whenever the active account has headroom, any fleet pane showing that menu gets one Escape.
set -euo pipefail

fleet_session=openrouter-autoscaler
credits_account=api-key-4@token.local
return_headroom_pct=10

wake_stuck_panes() {
  tmux has-session -t "$fleet_session" 2>/dev/null || return 0
  tmux list-panes -s -t "$fleet_session" -F '#{pane_id} #{pane_in_mode}' | while read -r pane in_mode; do
    # A pane in copy mode would swallow the key and stay locked.
    [ "$in_mode" = 0 ] || continue
    tmux capture-pane -p -t "$pane" | tail -20 | grep -q 'Stop and wait for limit to reset' || continue
    tmux send-keys -t "$pane" Escape
    echo "woke $pane: dismissed the usage-limit menu"
  done
}

cswap auto --json --threshold 80 --weekly-threshold 85 | while read -r line; do
  printf '%s\n' "$line"
  case "$(jq -r '.event' <<<"$line")" in
    all-exhausted)
      echo "every subscription account exhausted: switching to $credits_account"
      cswap switch "$credits_account"
      sleep 5; wake_stuck_panes
      ;;
    switch) sleep 5; wake_stuck_panes ;;
    poll)
      if [ "$(jq -r '.active.email' <<<"$line")" = "$credits_account" ]; then
        # Back to the subscription account with the most headroom once one has recovered.
        best=$(jq -r --argjson min "$return_headroom_pct" \
          '[.headroomPct | to_entries[] | select(.value >= $min)] | max_by(.value) | .key // empty' <<<"$line")
        if [ -n "$best" ]; then
          echo "subscription account $best has headroom: leaving $credits_account"
          cswap switch "$best"
        fi
      else
        headroom=$(jq -r '.headroomPct[(.active.number | tostring)] // 0' <<<"$line")
        if awk -v h="$headroom" 'BEGIN { exit !(h >= 5) }'; then wake_stuck_panes; fi
      fi
      ;;
  esac
done
