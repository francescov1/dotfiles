[Unit]
Description=claude-swap auto-switch

[Service]
# systemd's minimal PATH has neither ~/.local/bin (cswap) nor Homebrew's tmux, which the tmux server runs.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cswap-auto
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
