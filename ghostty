# Ghostty config
# Docs: ghostty +show-config --default --docs

# Hyper (caps lock via Karabiner = ctrl+opt+shift) + hjkl for tmux/vim pane nav.
# iTerm dropped the extra modifiers and sent plain ^H/^J/^K/^L; Ghostty encodes
# ctrl+alt+shift+<key> as CSI-u sequences tmux doesn't recognize, so send the
# raw control characters explicitly.
keybind = ctrl+alt+shift+g=text:\x07
keybind = ctrl+alt+shift+h=text:\x08
keybind = ctrl+alt+shift+j=text:\x0a
keybind = ctrl+alt+shift+k=text:\x0b
keybind = ctrl+alt+shift+l=text:\x0c
keybind = ctrl+alt+shift+backslash=text:\x1c

# option+u -> ESC u (M-u) for the tmux unread-tint toggle
keybind = alt+u=text:\x1bu

# Copy Ghostty's terminfo to hosts on ssh; without it TERM=xterm-ghostty is unknown remotely and
# zsh echoes garbled/doubled input and tmux won't attach.
shell-integration-features = ssh-terminfo

# option+shift+[ / ] -> ESC { / ESC } (M-{ / M-}) for tmux pane resize, held-repeat friendly
keybind = alt+shift+bracket_left=text:\x1b{
keybind = alt+shift+bracket_right=text:\x1b}
# option+shift+- / = -> ESC - / ESC = (M-- / M-=) for vertical tmux pane resize; avoids ESC _ (APC)
keybind = alt+shift+minus=text:\x1b-
keybind = alt+shift+equal=text:\x1b=
